{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Streamgraph showing public transport trips by mode across the capital cities from 1977 to 2025.",
  "width": 800,
  "height": 300,
  "data": {
    "url": "data/bitre_pt_trips_by_city_mode.csv",
    "format": {
      "type": "csv",
      "parse": {
        "trips_million": "number",
        "fy_end": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.city == 'All capital cities' && datum.mode != 'Total' && isValid(datum.trips_million)"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Archivo, 'Helvetica Neue', Arial, sans-serif",
    "axis": {
      "labelColor": "#3b4856",
      "titleColor": "#3b4856"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "fy_end",
          "type": "quantitative",
          "axis": {
            "title": "Year ending June",
            "format": "d",
            "grid": false,
            "tickCount": 10
          },
          "scale": {
            "nice": false
          }
        },
        "y": {
          "field": "trips_million",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Heavy rail",
              "Bus",
              "Light rail",
              "Ferry"
            ],
            "range": [
              "#1f5fa8",
              "#7fa8d1",
              "#2a9d8f",
              "#e0a030"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "mode",
            "title": "Mode"
          },
          {
            "field": "fy",
            "title": "Financial year"
          },
          {
            "field": "trips_million",
            "title": "Trips (millions)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2021,
            "t": "COVID-19"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#9b2c1f"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2021,
            "t": "COVID-19 lockdowns"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -128,
        "fontWeight": 600,
        "color": "#9b2c1f",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}
