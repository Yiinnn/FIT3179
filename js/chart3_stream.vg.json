{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Streamgraph showing public transport trips by mode across the capital cities from 1977 to 2025.",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/bitre_pt_trips_by_city_mode.csv",
    "format": {
      "type": "csv",
      "parse": {
        "trips_million": "number",
        "fy_end": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.city == 'All capital cities' && datum.mode != 'Total' && isValid(datum.trips_million)"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Serif 4', Georgia, serif",
    "axis": {
      "labelColor": "#3b4856",
      "titleColor": "#3b4856"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "fy_end",
          "type": "quantitative",
          "axis": {
            "title": "Year ending June",
            "format": "d",
            "grid": false,
            "tickCount": 10
          },
          "scale": {
            "nice": false
          }
        },
        "y": {
          "field": "trips_million",
          "type": "quantitative",
          "stack": "zero",
          "axis": {
            "title": "Trips (millions)",
            "grid": true,
            "tickCount": 5,
            "labelFontSize": 10,
            "titleFontSize": 11
          }
        },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Heavy rail",
              "Bus",
              "Light rail",
              "Ferry"
            ],
            "range": [
              "#2166ac",
              "#92c5de",
              "#f4a582",
              "#b35806"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "mode",
            "title": "Mode"
          },
          {
            "field": "fy",
            "title": "Financial year"
          },
          {
            "field": "trips_million",
            "title": "Trips (millions)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2021,
            "t": "COVID-19"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#b35806"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2021,
            "t": "COVID-19 lockdowns"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -128,
        "fontWeight": 600,
        "color": "#b35806",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
