{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Map comparing public transport commuting and working from home shares in each state in 2021.",
  "params": [
    {
      "name": "focusState",
      "value": "ALL"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Serif 4', Georgia, serif"
  },
  "hconcat": [
    {
      "width": 700,
      "height": 530,
      "projection": {
        "type": "conicEqualArea",
        "center": [
          0,
          -27
        ],
        "rotate": [
          132,
          0,
          0
        ],
        "parallels": [
          -18,
          -36
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/australia_states.json",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "transform": [
            {
              "lookup": "properties.STATE_CODE",
              "from": {
                "data": {
                  "url": "data/map_state_2021.csv",
                  "format": {
                    "type": "csv",
                    "parse": {
                      "ste_code": "number"
                    }
                  }
                },
                "key": "ste_code",
                "fields": [
                  "state",
                  "wfh_share_pct",
                  "pt_share_pct",
                  "hex",
                  "wfh_cls",
                  "pt_cls"
                ]
              }
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#ffffff",
            "strokeWidth": 1.5
          },
          "encoding": {
            "stroke": {
              "condition": {
                "test": "focusState === datum.state",
                "value": "#1b2a38"
              },
              "value": "#ffffff"
            },
            "strokeWidth": {
              "condition": {
                "test": "focusState === datum.state",
                "value": 3
              },
              "value": 1.5
            },
            "color": {
              "field": "hex",
              "type": "nominal",
              "scale": null,
              "legend": null
            },
            "tooltip": [
              {
                "field": "properties.STATE_NAME",
                "title": "State"
              },
              {
                "field": "wfh_share_pct",
                "title": "Worked at home (%)",
                "format": ".1f"
              },
              {
                "field": "pt_share_pct",
                "title": "Public transport (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/map_state_2021.csv"
          },
          "transform": [],
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 700
          },
          "encoding": {
            "longitude": {
              "field": "lbl_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lbl_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "state"
            },
            "color": {
              "value": "#162b3a"
            }
          }
        }
      ]
    },
    {
      "width": 122,
      "height": 122,
      "data": {
        "values": [
          {
            "w": 0,
            "p": 0,
            "hex": "#f1f1f1"
          },
          {
            "w": 1,
            "p": 0,
            "hex": "#d8dce6"
          },
          {
            "w": 2,
            "p": 0,
            "hex": "#c2cfe0"
          },
          {
            "w": 0,
            "p": 1,
            "hex": "#c5d9e4"
          },
          {
            "w": 1,
            "p": 1,
            "hex": "#aabccf"
          },
          {
            "w": 2,
            "p": 1,
            "hex": "#8fa9c2"
          },
          {
            "w": 0,
            "p": 2,
            "hex": "#7ea7bb"
          },
          {
            "w": 1,
            "p": 2,
            "hex": "#6d8fae"
          },
          {
            "w": 2,
            "p": 2,
            "hex": "#4f7293"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "w",
          "type": "ordinal",
          "axis": {
            "title": "Work from home: <15, 15–<25, 25%+",
            "labels": false,
            "ticks": false,
            "domain": false,
            "titleFontSize": 11,
            "titleFontWeight": "normal"
          }
        },
        "y": {
          "field": "p",
          "type": "ordinal",
          "sort": "descending",
          "axis": {
            "title": "Public transport: <3, 3–<5, 5%+",
            "labels": false,
            "ticks": false,
            "domain": false,
            "titleFontSize": 11,
            "titleFontWeight": "normal"
          }
        },
        "color": {
          "field": "hex",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    }
  ],
  "spacing": 18
}
