{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Map comparing public transport commuting and working from home shares in each state in 2021.",
  "params": [{ "name": "focusState", "value": "ALL" }],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Archivo, 'Helvetica Neue', Arial, sans-serif"
  },
  "hconcat": [
    {
      "width": 500,
      "height": 390,
      "projection": {
        "type": "mercator",
    "center": [134, -27]
      },
      "layer": [
        {
          "data": {
            "url": "data/australia_states.json",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "transform": [
            {
              "lookup": "properties.STATE_CODE",
              "from": {
                "data": {
                  "url": "data/map_state_2021.csv",
                  "format": {
                    "type": "csv",
                    "parse": {
                      "ste_code": "number"
                    }
                  }
                },
                "key": "ste_code",
                "fields": [
                  "state",
                  "wfh_share_pct",
                  "pt_share_pct",
                  "hex",
                  "wfh_cls",
                  "pt_cls"
                ]
              }
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#ffffff",
            "strokeWidth": 1.5
          },
          "encoding": {
            "stroke": {
              "condition": { "test": "focusState === datum.state", "value": "#1b2a38" },
              "value": "#ffffff"
            },
            "strokeWidth": {
              "condition": { "test": "focusState === datum.state", "value": 3 },
              "value": 1.5
            },
            "color": {
              "field": "hex",
              "type": "nominal",
              "scale": null,
              "legend": null
            },
            "tooltip": [
              {
                "field": "properties.STATE_NAME",
                "title": "State"
              },
              {
                "field": "wfh_share_pct",
                "title": "Worked at home (%)",
                "format": ".1f"
              },
              {
                "field": "pt_share_pct",
                "title": "Public transport (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/map_state_2021.csv"
          },
          "transform": [
            {
              "filter": "datum.state != 'ACT'"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 700
          },
          "encoding": {
            "longitude": {
              "field": "lbl_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lbl_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "state"
            },
            "color": {
              "condition": {
                "test": "datum.wfh_cls + datum.pt_cls >= 3",
                "value": "#ffffff"
              },
              "value": "#1b2a38"
            }
          }
        }
      ]
    },
    {
      "width": 96,
      "height": 96,
      "data": {
        "values": [
          {
            "w": 0,
            "p": 0,
            "hex": "#e8e8e8"
          },
          {
            "w": 1,
            "p": 0,
            "hex": "#e4acac"
          },
          {
            "w": 2,
            "p": 0,
            "hex": "#c85a5a"
          },
          {
            "w": 0,
            "p": 1,
            "hex": "#b0d5df"
          },
          {
            "w": 1,
            "p": 1,
            "hex": "#ad9ea5"
          },
          {
            "w": 2,
            "p": 1,
            "hex": "#985356"
          },
          {
            "w": 0,
            "p": 2,
            "hex": "#64acbe"
          },
          {
            "w": 1,
            "p": 2,
            "hex": "#627f8c"
          },
          {
            "w": 2,
            "p": 2,
            "hex": "#574249"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "w",
          "type": "ordinal",
          "axis": {
            "title": "More worked at home →",
            "labels": false,
            "ticks": false,
            "domain": false,
            "titleFontSize": 11,
            "titleFontWeight": "normal"
          }
        },
        "y": {
          "field": "p",
          "type": "ordinal",
          "sort": "descending",
          "axis": {
            "title": "More public transport →",
            "labels": false,
            "ticks": false,
            "domain": false,
            "titleFontSize": 11,
            "titleFontWeight": "normal"
          }
        },
        "color": {
          "field": "hex",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    }
  ],
  "spacing": 16
}
