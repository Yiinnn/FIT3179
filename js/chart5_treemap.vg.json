{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap showing public transport trips by city and mode in 2025.",
  "width": 850,
  "height": 510,
  "padding": 2,
  "autosize": "none",
  "data": [
    {
      "name": "tree",
      "url": "data/treemap_2024_25.csv",
      "format": {
        "type": "csv",
        "parse": {
          "size": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.parent === '' ? null : datum.parent",
          "as": "parent"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "size",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "paddingInner": 2,
          "paddingOuter": 3,
          "paddingTop": 22,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "cities",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 2"
        },
        {
          "type": "window",
          "ops": [
            "sum"
          ],
          "fields": [
            "size"
          ],
          "as": [
            "total_trips"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.size / datum.total_trips * 100",
          "as": "share_pct"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Heavy rail",
        "Bus",
        "Light rail",
        "Ferry"
      ],
      "range": [
        "#2166ac",
        "#6b8fb3",
        "#b35806",
        "#e69f00"
      ]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "orient": "bottom",
      "direction": "horizontal",
      "title": "Transport mode"
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "cities"
      },
      "encode": {
        "enter": {
          "fill": {
            "value": "#e3e9ef"
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#ffffff"
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "mode"
          },
          "tooltip": {
            "signal": "{'City': datum.city, 'Mode': datum.mode, 'Trips (millions)': format(datum.size, '.0f')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "cities"
      },
      "encode": {
        "enter": {
          "font": {
            "value": "Source Serif 4"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#1b2a38"
          }
        },
        "update": {
          "x": {
            "signal": "datum.x0 + 5"
          },
          "y": {
            "signal": "datum.y0 + 15"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0 > 60) ? datum.name : ''"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "font": {
            "value": "Source Serif 4"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#162b3a"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          }
        },
        "update": {
          "x": {
            "signal": "datum.x0 + 5"
          },
          "y": {
            "signal": "datum.y0 + 5"
          },
          "text": {
            "signal": "(datum.x1-datum.x0>76 && datum.y1-datum.y0>42) ? datum.mode + '\\n' + format(datum.size, '.0f') + 'm · ' + format(datum.share_pct, '.1f') + '%' : ''"
          },
          "limit": {
            "signal": "datum.x1-datum.x0-8"
          }
        }
      }
    }
  ]
}
