{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap showing annual public transport trips in each capital city compared with its 2019 level.",
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "top": 36,
    "left": 4,
    "right": 8,
    "bottom": 4
  },
  "data": {
    "url": "data/bitre_pt_recovery_index.csv",
    "format": {
      "type": "csv",
      "parse": {
        "index_2018_19": "number",
        "trips_million": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.mode == 'Total' && datum.city != 'All capital cities'"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Serif 4', Georgia, serif",
    "axis": {
      "labelColor": "#3b4856",
      "titleColor": "#3b4856",
      "labelFontSize": 12
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "fy",
          "type": "ordinal",
          "axis": {
            "title": "Financial year (July to June)",
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titlePadding": 10,
            "labelAngle": 0,
            "labelFontSize": 11,
            "labelOverlap": "parity",
            "ticks": false,
            "domain": false,
            "orient": "bottom"
          }
        },
        "y": {
          "field": "city",
          "type": "ordinal",
          "sort": [
            "Sydney",
            "Melbourne",
            "Brisbane",
            "Perth",
            "Adelaide",
            "Canberra",
            "Hobart",
            "Darwin"
          ],
          "axis": {
            "title": null,
            "ticks": false,
            "domain": false,
            "labelPadding": 8
          }
        },
        "color": {
          "field": "index_2018_19",
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              100,
              110
            ],
            "range": [
              "#b35806",
              "#f2f2f2",
              "#2166ac"
            ],
            "interpolate": "lab",
            "clamp": true
          },
          "legend": {
            "title": "Trips vs 2018–19 (index; 100 = baseline)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 340,
            "gradientThickness": 10,
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "labelFontSize": 11,
            "values": [
              40,
              60,
              80,
              100
            ],
            "titleLimit": 600
          }
        },
        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "fy",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "trips_million",
            "type": "quantitative",
            "title": "Trips (millions)",
            "format": ".1f"
          },
          {
            "field": "index_2018_19",
            "type": "quantitative",
            "title": "Compared with 2018-19",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 500
      },
      "encoding": {
        "x": {
          "field": "fy",
          "type": "ordinal"
        },
        "y": {
          "field": "city",
          "type": "ordinal",
          "sort": [
            "Sydney",
            "Melbourne",
            "Brisbane",
            "Perth",
            "Adelaide",
            "Canberra",
            "Hobart",
            "Darwin"
          ]
        },
        "text": {
          "field": "index_2018_19",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "value": "#162b3a"
        },
        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "fy",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "trips_million",
            "type": "quantitative",
            "title": "Trips (millions)",
            "format": ".1f"
          },
          {
            "field": "index_2018_19",
            "type": "quantitative",
            "title": "Compared with 2018-19",
            "format": ".0f"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.city == 'Melbourne' && datum.fy == '2020-21'"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "fy": "2020-21",
            "city": "Sydney",
            "note": "Lockdown years"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -22,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#b35806"
      },
      "encoding": {
        "x": {
          "field": "fy",
          "type": "ordinal",
          "bandPosition": 1
        },
        "y": {
          "field": "city",
          "type": "ordinal",
          "sort": [
            "Sydney",
            "Melbourne",
            "Brisbane",
            "Perth",
            "Adelaide",
            "Canberra",
            "Hobart",
            "Darwin"
          ]
        },
        "text": {
          "field": "note"
        }
      }
    }
  ]
}
