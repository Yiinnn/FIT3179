{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Map showing the share of employed people who used public transport to travel to work in each state in 2021.",
  "params": [{ "name": "focusState", "value": "ALL" }],
  "width": 800,
  "height": 450,
  "projection": {
    "type": "equalEarth"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Archivo, 'Helvetica Neue', Arial, sans-serif"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_CODE",
          "from": {
            "data": {
              "url": "data/map_state_2021.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "ste_code": "number",
                  "pt_share_pct": "number"
                }
              }
            },
            "key": "ste_code",
            "fields": [
              "state",
              "pt_share_pct",
              "lbl_lon",
              "lbl_lat"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "stroke": {
          "condition": { "test": "focusState === datum.state", "value": "#1b2a38" },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": { "test": "focusState === datum.state", "value": 3 },
          "value": 1.5
        },
        "color": {
          "field": "pt_share_pct",
          "type": "quantitative",
          "scale": {
            "range": [
              "#e3ebf3",
              "#1f5fa8"
            ]
          },
          "legend": {
            "title": "Public transport commuters (%)",
            "orient": "bottom",
            "gradientLength": 230,
            "titleFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State"
          },
          {
            "field": "pt_share_pct",
            "title": "Public transport (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/map_state_2021.csv",
        "format": {
          "type": "csv",
          "parse": {
            "pt_share_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.state != 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700,
        "dy": -7
      },
      "encoding": {
        "longitude": {
          "field": "lbl_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lbl_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        },
        "color": {
          "condition": {
            "test": "datum.pt_share_pct > 5.5",
            "value": "#ffffff"
          },
          "value": "#1b2a38"
        }
      }
    },
    {
      "data": {
        "url": "data/map_state_2021.csv",
        "format": {
          "type": "csv",
          "parse": {
            "pt_share_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.state != 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "dy": 8
      },
      "encoding": {
        "longitude": {
          "field": "lbl_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lbl_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "pt_share_pct",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.pt_share_pct > 5.5",
            "value": "#ffffff"
          },
          "value": "#1b2a38"
        }
      }
    }
  ]
}
