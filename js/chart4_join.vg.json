{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Rank slopegraph comparing state public transport commuting shares with capital city patronage recovery.",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/city_snapshot_map.csv",
    "format": {
      "type": "csv",
      "parse": {
        "recovery_pct_2024_25": "number"
      }
    }
  },
  "transform": [
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/abs_pt_share_by_state_2021.csv",
          "format": {
            "type": "csv",
            "parse": {
              "pt_share_pct": "number"
            }
          }
        },
        "key": "state",
        "fields": [
          "pt_share_pct"
        ]
      }
    },
    {
      "fold": [
        "pt_share_pct",
        "recovery_pct_2024_25"
      ],
      "as": [
        "measure",
        "value"
      ]
    },
    {
      "calculate": "datum.measure === 'pt_share_pct' ? 'PT commute share (state, 2021)' : 'Patronage recovery (city, 2024-25)'",
      "as": "measure_label"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "value",
          "order": "descending"
        }
      ],
      "groupby": [
        "measure_label"
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Serif 4', Georgia, serif",
    "axis": {
      "labelColor": "#3b4856",
      "titleColor": "#3b4856",
      "gridColor": "#e5ebf0",
      "domain": false,
      "ticks": false
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "opacity": 0.72
      },
      "encoding": {
        "x": {
          "field": "measure_label",
          "type": "ordinal",
          "sort": [
            "PT commute share (state, 2021)",
            "Patronage recovery (city, 2024-25)"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelPadding": 14,
            "labelLimit": 250
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              8
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": "City rank (1 = highest)",
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "grid": true,
            "labelFontSize": 11
          }
        },
        "detail": {
          "field": "city"
        },
        "order": {
          "field": "measure_label",
          "sort": [
            "PT commute share (state, 2021)",
            "Patronage recovery (city, 2024-25)"
          ]
        },
        "color": {
          "condition": {
            "test": "indexof(['Perth','Darwin'], datum.city) >= 0",
            "field": "city",
            "type": "nominal",
            "scale": {
              "domain": [
                "Perth",
                "Darwin"
              ],
              "range": [
                "#2166ac",
                "#b35806"
              ]
            },
            "legend": null
          },
          "value": "#b9c1c8"
        },
        "tooltip": [
          {
            "field": "city",
            "title": "Capital city"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "pt_share_pct",
            "title": "Workers using public transport on Census day (%)",
            "format": ".1f"
          },
          {
            "field": "recovery_pct_2024_25",
            "title": "City patronage vs 2018-19 (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 100,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "measure_label",
          "type": "ordinal",
          "sort": [
            "PT commute share (state, 2021)",
            "Patronage recovery (city, 2024-25)"
          ]
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              8
            ],
            "reverse": true,
            "nice": false
          }
        },
        "color": {
          "condition": {
            "test": "indexof(['Perth','Darwin'], datum.city) >= 0",
            "field": "city",
            "type": "nominal",
            "scale": {
              "domain": [
                "Perth",
                "Darwin"
              ],
              "range": [
                "#2166ac",
                "#b35806"
              ]
            },
            "legend": null
          },
          "value": "#b9c1c8"
        },
        "tooltip": [
          {
            "field": "city",
            "title": "Capital city"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "pt_share_pct",
            "title": "Workers using public transport on Census day (%)",
            "format": ".1f"
          },
          {
            "field": "recovery_pct_2024_25",
            "title": "City patronage vs 2018-19 (%)",
            "format": ".1f"
          },
          {
            "field": "rank",
            "title": "Rank on this measure"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.measure_label === 'PT commute share (state, 2021)'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -11,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1b2a38"
      },
      "encoding": {
        "x": {
          "field": "measure_label",
          "type": "ordinal",
          "sort": [
            "PT commute share (state, 2021)",
            "Patronage recovery (city, 2024-25)"
          ]
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              8
            ],
            "reverse": true,
            "nice": false
          }
        },
        "text": {
          "field": "city"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.measure_label === 'Patronage recovery (city, 2024-25)'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1b2a38"
      },
      "encoding": {
        "x": {
          "field": "measure_label",
          "type": "ordinal",
          "sort": [
            "PT commute share (state, 2021)",
            "Patronage recovery (city, 2024-25)"
          ]
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              8
            ],
            "reverse": true,
            "nice": false
          }
        },
        "text": {
          "field": "city"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
