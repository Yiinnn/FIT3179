{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiple horizontal bar charts comparing commute mode shares by state in the 2021 Census.",
  "data": {
    "url": "data/abs_commute_by_state_2021.csv",
    "format": {
      "type": "csv",
      "parse": {
        "share_of_employed_pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.state != 'AUS' && indexof(['Public transport','Car','Walk / cycle','Worked at home'], datum.mode_group) >= 0"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "share_of_employed_pct",
          "as": "share"
        }
      ],
      "groupby": ["state", "mode_group"]
    }
  ],
  "facet": {
    "row": {
      "field": "mode_group",
      "type": "nominal",
      "sort": ["Public transport", "Car", "Walk / cycle", "Worked at home"],
      "header": {
        "title": null,
        "labelAngle": 0,
        "labelAlign": "left",
        "labelFontSize": 13,
        "labelFontWeight": 700,
        "labelPadding": 8
      }
    }
  },
  "spec": {
    "width": 720,
    "height": {"step": 24},
    "mark": {"type": "bar", "cornerRadiusEnd": 3, "height": 14},
    "encoding": {
      "y": {
        "field": "state",
        "type": "nominal",
        "sort": {"field": "share", "order": "descending"},
        "axis": {"title": null, "labelFontSize": 11, "ticks": false, "domain": false}
      },
      "x": {
        "field": "share",
        "type": "quantitative",
        "scale": {"zero": true},
        "axis": {"title": "Employed people (%)", "format": ".0f", "tickCount": 4, "grid": true, "labelFontSize": 10, "titleFontSize": 11}
      },
      "color": {
        "field": "mode_group",
        "type": "nominal",
        "legend": null,
        "scale": {"scheme": "dark2"}
      },
      "tooltip": [
        {"field": "state", "title": "State"},
        {"field": "mode_group", "title": "Travel mode"},
        {"field": "share", "title": "Share of employed people (%)", "format": ".1f"}
      ]
    },
    "config": {
      "view": {"stroke": null},
      "font": "Archivo, 'Helvetica Neue', Arial, sans-serif",
      "axis": {"labelColor": "#3b4856", "gridColor": "#e6e8e4"}
    }
  },
  "resolve": {"scale": {"x": "independent", "y": "shared"}},
  "config": {
    "view": {"stroke": null},
    "font": "Archivo, 'Helvetica Neue', Arial, sans-serif"
  }
}
