{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart showing the work travel choices of 100 employed Australians in 2021.",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/waffle_2021.csv"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Serif 4', Georgia, serif"
  },
  "mark": {
    "type": "rect",
    "stroke": "#f5f7f9",
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "descending",
      "axis": null
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "scale": {
        "domain": [
          "Car (57)",
          "Worked at home (21)",
          "Did not go to work (12)",
          "Public transport (5)",
          "Walk / cycle (3)",
          "Other (2)"
        ],
        "range": [
          "#52616b",
          "#b35806",
          "#d6dbe0",
          "#2166ac",
          "#f4a582",
          "#8c969d"
        ]
      },
      "legend": {
        "title": "One square = 1 in 100 workers",
        "orient": "right",
        "labelFontSize": 12,
        "titleFontSize": 12,
        "titleFontWeight": "normal"
      }
    },
    "tooltip": [
      {
        "field": "label",
        "title": "Group"
      }
    ]
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
