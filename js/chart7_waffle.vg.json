{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart showing the work travel choices of 100 employed Australians in 2021.",
  "width": 300,
  "height": 300,
  "data": {
    "url": "data/waffle_2021.csv"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Archivo, 'Helvetica Neue', Arial, sans-serif"
  },
  "mark": {
    "type": "rect",
    "stroke": "#f5f7f9",
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "descending",
      "axis": null
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "scale": {
        "domain": [
          "Car (57)",
          "Worked at home (21)",
          "Did not go to work (12)",
          "Public transport (5)",
          "Walk / cycle (3)",
          "Other (2)"
        ],
        "range": [
          "#5b6b7a",
          "#2a9d8f",
          "#c9d2da",
          "#1f5fa8",
          "#e0a030",
          "#9b2c1f"
        ]
      },
      "legend": {
        "title": "One square = 1 in 100 workers",
        "orient": "right",
        "labelFontSize": 12,
        "titleFontSize": 12,
        "titleFontWeight": "normal"
      }
    },
    "tooltip": [
      {
        "field": "label",
        "title": "Group"
      }
    ]
  }
}
