{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart comparing the share of workers who drove to work in each capital city and the rest of its state in 2021.",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/abs_drivers_capital_vs_rest_2021.csv",
    "format": {
      "type": "csv",
      "parse": {
        "greater_capital_pct": "number",
        "rest_of_state_pct": "number"
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Serif 4', Georgia, serif",
    "axis": {
      "labelColor": "#3b4856",
      "titleColor": "#3b4856"
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "isValid(datum.rest_of_state_pct) && isValid(datum.greater_capital_pct)"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#c9d2da",
        "strokeWidth": 4
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "NT",
            "SA",
            "WA",
            "TAS",
            "ACT",
            "QLD",
            "VIC",
            "NSW"
          ],
          "axis": {
            "title": null,
            "ticks": false,
            "domain": false,
            "labelFontSize": 12
          }
        },
        "x": {
          "field": "greater_capital_pct",
          "type": "quantitative",
          "scale": {
            "zero": false
          },
          "axis": {
            "title": "Employed people who drove to work, 2021 (%)",
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "grid": false,
            "tickCount": 5
          }
        },
        "x2": {
          "field": "rest_of_state_pct"
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "greater_capital_pct",
            "rest_of_state_pct"
          ],
          "as": [
            "measure",
            "value"
          ]
        },
        {
          "filter": "isValid(datum.value)"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 150,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "NT",
            "SA",
            "WA",
            "TAS",
            "ACT",
            "QLD",
            "VIC",
            "NSW"
          ],
          "axis": {
            "title": null,
            "ticks": false,
            "domain": false,
            "labelFontSize": 12
          }
        },
        "x": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "zero": false
          },
          "axis": {
            "tickCount": 5,
            "grid": true
          }
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "greater_capital_pct",
              "rest_of_state_pct"
            ],
            "range": [
              "#1f5fa8",
              "#e0a030"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "labelExpr": "datum.value == 'greater_capital_pct' ? 'Capital city' : 'Rest of state'",
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "value",
            "title": "Drove to work (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
